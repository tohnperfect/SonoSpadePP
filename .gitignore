.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.DS_Store

# Data, runs and weights stay out of git. TRUSTED (data usage agreement): the data and every image
# derived from it stay out of git, including the same-patient figure.
data/*
!data/splits_v2.json
runs/
runs_smoke/
logs/
*.pt
*.pth
*.onnx
*.safetensors
*.npz

# Run outputs: only the summaries and the approved comparison panel are tracked
outputs/*
!outputs/compare.json
!outputs/compare_panel.png
!outputs/m6_hu_use.json
!outputs/m9_summary.json
!outputs/merge_summary.json

# Figures are rebuilt locally; two qualitative figures are tracked (see figures/README.md)
figures/*
!figures/README.md
!figures/qual.pdf
!figures/qual_baselines.pdf

# Generated LaTeX macros (scripts/v2/paper_macros_v2.py) and smoke rows
results/paper_macros/
results/v2/rows_smoke/
